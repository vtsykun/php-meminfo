{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    { "name": "php-7.0", "displayName": "PHP 7.0", "inherits": "base", "cacheVariables": { "PHP_VERSION": "7.0" } },
    { "name": "php-7.1", "displayName": "PHP 7.1", "inherits": "base", "cacheVariables": { "PHP_VERSION": "7.1" } },
    { "name": "php-7.2", "displayName": "PHP 7.2", "inherits": "base", "cacheVariables": { "PHP_VERSION": "7.2" } },
    { "name": "php-7.3", "displayName": "PHP 7.3", "inherits": "base", "cacheVariables": { "PHP_VERSION": "7.3" } },
    { "name": "php-7.4", "displayName": "PHP 7.4", "inherits": "base", "cacheVariables": { "PHP_VERSION": "7.4" } },
    { "name": "php-8.0", "displayName": "PHP 8.0", "inherits": "base", "cacheVariables": { "PHP_VERSION": "8.0" } },
    { "name": "php-8.1", "displayName": "PHP 8.1", "inherits": "base", "cacheVariables": { "PHP_VERSION": "8.1" } },
    { "name": "php-8.2", "displayName": "PHP 8.2", "inherits": "base", "cacheVariables": { "PHP_VERSION": "8.2" } },
    { "name": "php-8.3", "displayName": "PHP 8.3", "inherits": "base", "cacheVariables": { "PHP_VERSION": "8.3" } },
    { "name": "php-8.4", "displayName": "PHP 8.4", "inherits": "base", "cacheVariables": { "PHP_VERSION": "8.4" } },
    { "name": "php-8.5", "displayName": "PHP 8.5", "inherits": "base", "cacheVariables": { "PHP_VERSION": "8.5" } },
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "MEMINFO_S3": "ON",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/extension/deps"
      }
    },
    { "name": "php-8.4-s3", "displayName": "PHP 8.4 + S3 (vcpkg)", "inherits": ["vcpkg", "php-8.4"] },
    { "name": "php-8.5-s3", "displayName": "PHP 8.5 + S3 (vcpkg)", "inherits": ["vcpkg", "php-8.5"] }
  ]
}

