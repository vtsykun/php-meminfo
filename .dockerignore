# Build context for the root Dockerfile.
# Host build artifacts must never reach the image: the extension is rebuilt
# from scratch with phpize inside the container.

# VCS, IDE and agent tooling
.git
.github
.idea
.ai-factory
.ai-factory.json
.claude
.mcp.json
*.dump

# IDE code insight: extracted PHP headers and CMake build directories
.ide
cmake-build-*

# Extension: everything generated by phpize/configure/make (see extension/.gitignore)
extension/Makefile.in
extension/autom4te.cache
extension/aclocal.m4
extension/compile
extension/depcomp
extension/.deps
extension/**/*.lo
# Dependency files from PHP 8.3+ phpize builds; they carry host paths
extension/**/*.dep
extension/**/*.la
extension/**/*.o
extension/.libs
extension/Makefile
extension/Makefile.fragments
extension/Makefile.global
extension/Makefile.objects
extension/acinclude.m4
extension/build
extension/config.guess
extension/config.h
extension/config.h.in
extension/config.log
extension/config.nice
extension/config.status
extension/config.sub
extension/configure
extension/configure.ac
extension/configure.in
extension/install-sh
extension/libtool
extension/ltmain.sh
extension/missing
extension/mkinstalldirs
extension/modules
extension/run-tests.php
extension/include
extension/tmp-php.ini
extension/.configure-args

# Extension: .phpt test outputs
extension/tests/*.out
extension/tests/*.diff
extension/tests/*.exp
extension/tests/*.log
extension/tests/*.sh
extension/tests/*.php.tmp

# Browser UI: a Node project of its own, not part of the image (and its
# node_modules and generated test dumps run to hundreds of MB)
ui

# vcpkg install tree of the host; the S3 image installs its own
vcpkg_installed
**/.meminfo-deps
